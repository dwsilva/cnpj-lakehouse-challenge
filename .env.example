# Opcional — o docker compose já tem estes defaults.
# Copie só se quiser alterar vintage, amostra ou ReceitaWS:
#   cp .env.example .env

# Caminho do banco DuckDB (dentro do container)
DUCKDB_PATH=/app/duckdb/cnpj.duckdb

# Vintage RF (pasta em data/raw/{vintage}/)
RF_VINTAGE=2026-07-12
RF_BASE_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br

# Amostra local: 10000 = ~10k linhas (item 4 do enunciado)
SAMPLE_N_ROWS=10000

# ReceitaWS — enriquecimento complementar via API
ENABLE_RECEITAWS=true
RECEITAWS_BASE_URL=https://receitaws.com.br/v1/cnpj
RECEITAWS_SAMPLE_SIZE=5
RECEITAWS_REQUEST_DELAY_SECONDS=3

# Prefect. Vazio = modo local sem UI (docker compose run --rm pipeline)
# Com profile prefect: http://prefect-server:4200/api
PREFECT_API_URL=
PREFECT_LOGGING_LEVEL=INFO

# Schedule mensal da ingestão completa (cron + timezone)
PREFECT_COLETA_CRON=0 6 5 * *
PREFECT_COLETA_TIMEZONE=America/Sao_Paulo
